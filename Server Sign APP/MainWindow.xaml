<Window x:Class="KSKSigningManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KSK Signing Server"
        Width="1080" Height="760"
        MinWidth="950" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="KSK SIGNING SERVER" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Primary}"/>
                <TextBlock Text="Quản lý ký số MISA-CA qua mạng LAN" Margin="0,4,0,0" FontSize="14" Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>
            <Border Grid.Column="1" x:Name="ServerStateBadge" Background="#E5E7EB" CornerRadius="16" Padding="14,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StateDot" Width="10" Height="10" Fill="#6B7280" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ServerStateText" Text="ĐÃ DỪNG" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Chứng thư MISA-CA" FontWeight="SemiBold"/>
                    <DockPanel Grid.Column="1">
                        <Button Content="Quét lại" DockPanel.Dock="Right" Width="88" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Click="RefreshCertificates_Click"/>
                        <ComboBox x:Name="CertificateCombo" DisplayMemberPath="DisplayName" SelectionChanged="CertificateCombo_SelectionChanged"/>
                    </DockPanel>
                    <TextBlock Grid.Row="2" Text="Thumbprint" FontWeight="SemiBold"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="ThumbprintText" IsReadOnly="True" Background="#F8FAFC"/>
                    <TextBlock Grid.Row="4" Text="PIN Token" FontWeight="SemiBold"/>
                    <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="PinBox"/>
                    <TextBlock Grid.Row="6" Text="Ghi nhớ PIN" FontWeight="SemiBold"/>
                    <CheckBox Grid.Row="6" Grid.Column="1" x:Name="RememberPinCheck" Content="Mã hóa bằng Windows DPAPI trên tài khoản này" IsChecked="True" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="8" Text="Cổng Server" FontWeight="SemiBold"/>
                    <TextBox Grid.Row="8" Grid.Column="1" x:Name="PortText" Text="7443" TextChanged="PortText_TextChanged"/>
                    <TextBlock Grid.Row="10" Text="API Key" FontWeight="SemiBold"/>
                    <Grid Grid.Row="10" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="ApiKeyText"
                                 Grid.Column="0"
                                 MinWidth="220"
                                 FontFamily="Consolas"
                                 VerticalContentAlignment="Center"
                                 ToolTip="API Key dùng cho máy khách"/>

                        <Button Grid.Column="1"
                                Content="COPY"
                                Width="72"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="CopyApiKey_Click"/>

                        <Button Grid.Column="2"
                                Content="Tạo mới"
                                Width="82"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="GenerateApiKey_Click"/>
                    </Grid>
                    <TextBlock Grid.Row="12" Text="Phạm vi truy cập" FontWeight="SemiBold"/>
                    <StackPanel Grid.Row="12" Grid.Column="1">
                        <ComboBox x:Name="AccessModeCombo" SelectedIndex="0">
                            <ComboBoxItem Content="Tất cả máy trong mạng LAN hiện tại" Tag="LAN"/>
                            <ComboBoxItem Content="Chỉ máy này" Tag="LOCAL"/>
                            <ComboBoxItem Content="Danh sách IP tùy chỉnh" Tag="CUSTOM"/>
                        </ComboBox>
                        <TextBox x:Name="AllowedIpsText" Margin="0,8,0,0" Text="192.168.1.0/24" ToolTip="Phân cách bằng dấu phẩy"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="VẬN HÀNH" FontWeight="Bold" FontSize="15"/>
                    <Separator Margin="0,12"/>
                    <TextBlock Text="Địa chỉ LAN" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="AddressText" Text="Đang xác định..." FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    <TextBlock Text="Chứng thư" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="CertificateStatusText" Text="Chưa kiểm tra" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    <TextBlock Text="Tiến trình Server" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="ProcessStatusText" Text="Chưa chạy" Margin="0,4,0,16"/>
                    <Button x:Name="StartButton" Content="KHỞI ĐỘNG SERVER" Style="{StaticResource PrimaryButton}" Click="StartServer_Click"/>
                    <Button x:Name="StopButton" Content="DỪNG SERVER" Margin="0,8,0,0" Style="{StaticResource DangerButton}" Click="StopServer_Click" IsEnabled="False"/>
                    <Button Content="LƯU CẤU HÌNH" Margin="0,8,0,0" Style="{StaticResource SecondaryButton}" Click="Save_Click"/>
                    <Separator Margin="0,16,0,12"/>
                    <CheckBox x:Name="AutoStartWindowsCheck" Content="Khởi động cùng Windows" Margin="0,0,0,8"/>
                    <CheckBox x:Name="StartMinimizedCheck" Content="Khởi động thu nhỏ xuống khay hệ thống" Margin="0,0,0,8"/>
                    <CheckBox x:Name="AutoStartServerCheck" Content="Tự khởi động server khi mở ứng dụng"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="12" Padding="14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="NHẬT KÝ HOẠT ĐỘNG" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Mở thư mục log" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Click="OpenLogs_Click"/>
                        <Button Content="Xóa hiển thị" Style="{StaticResource SecondaryButton}" Click="ClearLog_Click"/>
                    </StackPanel>
                </DockPanel>
                <ListBox Grid.Row="2" x:Name="LogList" FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="#0F172A" Foreground="#E2E8F0" Padding="10"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="6" x:Name="FooterText" Text="Đóng cửa sổ sẽ thu nhỏ xuống khay hệ thống. Dùng menu khay để thoát hoàn toàn." Foreground="{StaticResource TextSecondary}"/>
    </Grid>
</Window>

