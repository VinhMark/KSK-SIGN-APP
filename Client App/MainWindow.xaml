<Window x:Class="GKSKLaiXe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GKSKLaiXe.Windows"
        Icon="/Assets/app_modern.ico"
        Title="GKSK &amp; Dữ liệu XML"
        Height="900" Width="1600"
        MinWidth="1180" MinHeight="700"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource AppBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="16,14"
                        Background="#173F86"
                        BorderBrush="#2C5AA7"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34"
                                Background="White"
                                CornerRadius="9"
                                Margin="0,0,10,0">
                            <Image Source="/Assets/app_logo.png"
                                   Width="25" Height="25"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="GKSK &amp; Dữ liệu XML"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1"
                            Margin="18,26,18,22"
                            HorizontalAlignment="Center">
                    <Border Width="86" Height="86"
                            Background="White"
                            CornerRadius="22"
                            Margin="0,0,0,16">
                        <Image Source="/Assets/app_logo.png"
                               Width="66" Height="66"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="GKSK &amp;&#x0a;DỮ LIỆU XML"
                               Foreground="White"
                               FontSize="19"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               LineHeight="28"/>
                    <TextBlock Text="Liên thông KSK - Xuất dữ liệu"
                               Foreground="#C9D9F5"
                               FontSize="11"
                               Margin="0,8,0,0"
                               TextAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="16,0">
                    <Button x:Name="NavKskButton"
                            Style="{StaticResource SidebarButtonActive}"
                            Click="ShowDriverKskScreen_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SidebarIcon}" Text="&#xE774;"/>
                            <TextBlock Text="Liên thông KSK"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavXmlButton"
                            Style="{StaticResource SidebarButton}"
                            Click="ShowXmlScreen_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SidebarIcon}" Text="&#xE8A5;"/>
                            <TextBlock Text="Dữ liệu XML"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavSettingsButton"
                            Style="{StaticResource SidebarButton}"
                            Click="Settings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SidebarIcon}" Text="&#xE713;"/>
                            <TextBlock Text="Cấu hình"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="3"
                        Margin="16,0,16,18"
                        Padding="15"
                        CornerRadius="10"
                        Background="#244F91">
                    <StackPanel>
                        <TextBlock Text="Thông tin hệ thống"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Phiên bản:" Foreground="#E7EFFC"/>
                            <TextBlock Grid.Column="1" Text="1.0.0" Foreground="White"/>
                            <TextBlock Grid.Row="1" Text="Cập nhật:" Foreground="#E7EFFC"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="23/07/2026" Foreground="White"/>
                            <TextBlock Grid.Row="2" Text="Tác giả:" Foreground="#E7EFFC"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Văn Vinh" Foreground="White"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            Margin="20,0,16,24">
                    <Ellipse Width="10" Height="10"
                             Fill="#28D98F"
                             Margin="0,0,10,0"/>
                    <TextBlock Text="Kết nối: Thành công"
                               Foreground="White"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Margin="20,18,22,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="Transparent"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE774;"
                                       FontSize="30"
                                       Foreground="#08B8C8"
                                       Margin="0,0,12,0"/>
                            <TextBlock x:Name="FeatureTitleText"
                                       Text="LIÊN THÔNG KHÁM SỨC KHỎE"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Primary}"/>
                        </StackPanel>
                        <TextBlock x:Name="FeatureSubtitleText"
                                   Text="Lấy dữ liệu, kiểm tra và xuất dữ liệu giám định"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="42,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="DriverModeButton"
                                Style="{StaticResource ModeButtonActive}"
                                Content="Khám Sức Khỏe Lái Xe"
                                Click="ShowDriverKskScreen_Click"/>
                        <Button x:Name="GeneralModeButton"
                                Style="{StaticResource ModeButton}"
                                Content="Khám Sức Khỏe"
                                Margin="8,0,0,0"
                                Click="ShowGeneralKskScreen_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl x:Name="MainScreenTabs"
                        Grid.Row="1"
                        SelectedIndex="0"
                        Background="Transparent"
                        BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.Resources>

            <TabItem Header="KSK LÁI XE">
                <DockPanel>
<!-- Hàng chức năng chính -->
        <Border DockPanel.Dock="Top" Background="White" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Nhóm thao tác dữ liệu bên trái -->
                <WrapPanel Grid.Column="0"
                           VerticalAlignment="Center">

                    <Button x:Name="LoadSqlButton"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,10,0"
                            Padding="14,8"
                            Click="LoadSql_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE895;"/>
                            <TextBlock Text="Lấy dữ liệu SQL"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0"
                            Padding="14,8"
                            Click="SelectPackages_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE71B;"/>
                            <TextBlock Text="Chọn gói"/>
                        </StackPanel>
                    </Button>

                    <CheckBox x:Name="OnlyPaidCheck"
                              Content="Thanh toán"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0"/>

                    <CheckBox x:Name="ShowSentCheck"
                              Content="Đã gửi"
                              VerticalAlignment="Center"
                              Margin="0,0,18,0"
                              Checked="ShowSentCheck_Changed"
                              Unchecked="ShowSentCheck_Changed"
                              ToolTip="Bật: chỉ hiển thị hồ sơ đã gửi. Tắt: chỉ hiển thị hồ sơ chưa gửi."/>
                </WrapPanel>

                <!-- Nhóm thao tác hệ thống bên phải -->
                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">

                    <Button Style="{StaticResource SecondaryButton}"
                            Content="Tải file import mẫu"
                            Margin="0,0,8,0"
                            Padding="14,8"
                            Click="DownloadImportSample_Click"/>


                    <Button Style="{StaticResource SecondaryButton}" Content="Import Excel"
                            Margin="0,0,8,0"
                            Padding="14,8"
                            Click="ImportExcel_Click"/>

                    <Button Style="{StaticResource SecondaryButton}" Content="Xuất excel"
                            Margin="0,0,8,0"
                            Padding="14,8"
                            Click="ExportExcel_Click"/>

                    <Button Style="{StaticResource SecondaryButton}" Content="Kiểm tra"
                            Margin="0,0,8,0"
                            Padding="14,8"
                            Click="Validate_Click"/>

                    <Button x:Name="ExportSignedXmlButton"
                            Style="{StaticResource SecondaryButton}"
                            Content="Xuất XML ký số"
                            Margin="0,0,8,0"
                            Padding="14,8"
                            ToolTip="Ký hồ sơ đã chọn bằng Signing Server hoặc Token trực tiếp, sau đó lưu XML để kiểm tra; không gửi cổng và không ghi lịch sử đã gửi."
                            Click="ExportSignedXml_Click"/>

                    <Button x:Name="SendApiButton" Style="{StaticResource PrimaryButton}" Content="Đẩy cổng giám định"
                            Padding="16,8"
                            Click="SendApi_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Hàng tìm kiếm riêng, nằm ngay trên TableView -->
        <Border DockPanel.Dock="Top"
                Background="White"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,0,0,1"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Kiểu lọc:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="DriverFilterTypeCombo" Width="165" Height="30" Margin="0,0,12,0" SelectedIndex="0" SelectionChanged="DriverFilterType_Changed">
                        <ComboBoxItem Content="Từ ngày - Đến ngày" Tag="RANGE"/><ComboBoxItem Content="Ngày" Tag="DAY"/><ComboBoxItem Content="Tháng" Tag="MONTH"/><ComboBoxItem Content="Quý" Tag="QUARTER"/><ComboBoxItem Content="Năm" Tag="YEAR"/>
                    </ComboBox>
                    <StackPanel x:Name="DriverRangePanel" Orientation="Horizontal"><TextBlock Text="Từ ngày:" VerticalAlignment="Center" Margin="0,0,6,0"/><DatePicker x:Name="DriverFromDatePicker" Width="125" Height="30" Margin="0,0,10,0"/><TextBlock Text="Đến ngày:" VerticalAlignment="Center" Margin="0,0,6,0"/><DatePicker x:Name="DriverToDatePicker" Width="125" Height="30" Margin="0,0,12,0"/></StackPanel>
                    <StackPanel x:Name="DriverDayPanel" Orientation="Horizontal" Visibility="Collapsed"><TextBlock Text="Ngày:" VerticalAlignment="Center" Margin="0,0,6,0"/><DatePicker x:Name="DriverDayPicker" Width="125" Height="30" Margin="0,0,12,0"/></StackPanel>
                    <StackPanel x:Name="DriverMonthPanel" Orientation="Horizontal" Visibility="Collapsed"><TextBlock Text="Tháng:" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="DriverMonthCombo" Width="80" Height="30" Margin="0,0,12,0"/><TextBlock Text="Năm:" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="DriverMonthYearCombo" Width="90" Height="30" Margin="0,0,12,0"/></StackPanel>
                    <StackPanel x:Name="DriverQuarterPanel" Orientation="Horizontal" Visibility="Collapsed"><TextBlock Text="Quý:" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="DriverQuarterCombo" Width="80" Height="30" Margin="0,0,12,0"/><TextBlock Text="Năm:" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="DriverQuarterYearCombo" Width="90" Height="30" Margin="0,0,12,0"/></StackPanel>
                    <StackPanel x:Name="DriverYearPanel" Orientation="Horizontal" Visibility="Collapsed"><TextBlock Text="Năm:" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="DriverYearCombo" Width="90" Height="30" Margin="0,0,12,0"/></StackPanel>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox x:Name="SearchBox"
                             Width="320"
                             Height="30"
                             VerticalContentAlignment="Center"
                             ToolTip="Tìm nhanh trên toàn bộ dữ liệu đang tải"
                             KeyDown="SearchBox_KeyDown"
                             TextChanged="SearchBox_TextChanged"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="⌕  Tìm kiếm"
                            Width="100"
                            Height="30"
                            Margin="6,0,0,0"
                            Padding="8,3"
                            Click="Search_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Thanh trạng thái + tiến trình gửi hàng loạt -->
        <Border DockPanel.Dock="Bottom"
                Background="White"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,1,0,0"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           Text="Sẵn sàng."
                           VerticalAlignment="Center"/>

                <ProgressBar x:Name="SendProgressBar"
                             Grid.Column="1"
                             Height="18"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Visibility="Collapsed"
                             Margin="12,0,10,0"
                             VerticalAlignment="Center"/>

                <TextBlock x:Name="SendProgressText"
                           Grid.Column="2"
                           Text=""
                           MinWidth="90"
                           TextAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Bảng dữ liệu -->
        <DataGrid x:Name="Grid"
                  AutoGenerateColumns="False"
                  VerticalContentAlignment="Center"
                  RowHeaderWidth="0"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="False"
                  SelectionUnit="FullRow"
                  SelectionMode="Extended"
                  FrozenColumnCount="2"
                  Margin="16,10,16,14"
                  HeadersVisibility="All"
                  GridLinesVisibility="All">

            <DataGrid.Columns>

                <!-- Checkbox ở header dùng để chọn/bỏ chọn tất cả các dòng đang hiển thị -->
                <DataGridTemplateColumn Width="60">
                    <DataGridTemplateColumn.Header>
                        <CheckBox x:Name="SelectAllHeaderCheck"
                                  Style="{StaticResource GridCheckBoxStyle}"
                                  IsThreeState="True"
                                  Click="SelectAllHeaderCheck_Click"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource GridCheckBoxStyle}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

<DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" EditingElementStyle="{StaticResource CenteredDataGridEditingText}" Header="Số KSK"
                                    Binding="{Binding SO}"
                                    Width="215"/>
                <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" EditingElementStyle="{StaticResource CenteredDataGridEditingText}" Header="Người Giới Thiệu"
                                    Binding="{Binding IntroName}"
                                    Width="160"
                                    IsReadOnly="True"/>



                <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" EditingElementStyle="{StaticResource CenteredDataGridEditingText}" Header="Gói Khám"
                                    Binding="{Binding ServiceName}"
                                    Width="220"/>

                <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" EditingElementStyle="{StaticResource CenteredDataGridEditingText}" Header="Ngày tạo"
                                    Binding="{Binding CreateDate, StringFormat=dd/MM/yyyy HH:mm}"
                                    Width="150"/>

                <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}"
                                    Header="Loại KSK"
                                    Binding="{Binding DriverHealthCategory}"
                                    Width="190"
                                    IsReadOnly="True"/>

                <DataGridTemplateColumn Header="Thanh Toán" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="PaidBadge"
                                    Background="#FFF4CC"
                                    BorderBrush="#F1C84B"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="PaidBadgeTextBlock"
                                           Text="{Binding PaidDisplay}"
                                           Style="{StaticResource PaidBadgeText}"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding PaidDisplay}"
                                             Value="Đã Thanh Toán">
                                    <Setter TargetName="PaidBadge"
                                            Property="Background"
                                            Value="#DDF7E8"/>
                                    <Setter TargetName="PaidBadge"
                                            Property="BorderBrush"
                                            Value="#68C98C"/>
                                    <Setter TargetName="PaidBadgeTextBlock"
                                            Property="Foreground"
                                            Value="#16713B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PaidDisplay}"
                                             Value="Đã thanh toán">
                                    <Setter TargetName="PaidBadge"
                                            Property="Background"
                                            Value="#DDF7E8"/>
                                    <Setter TargetName="PaidBadge"
                                            Property="BorderBrush"
                                            Value="#68C98C"/>
                                    <Setter TargetName="PaidBadgeTextBlock"
                                            Property="Foreground"
                                            Value="#16713B"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Hạng GPLX" Width="115">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox SelectedValue="{Binding HANGBANGLAI, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Content">
                                <ComboBoxItem Content="A"/>
                                <ComboBoxItem Content="A.03"/>
                                <ComboBoxItem Content="B"/>
                                <ComboBoxItem Content="B1"/>
                                <ComboBoxItem Content="B0.1"/>
                                <ComboBoxItem Content="BE"/>
                                <ComboBoxItem Content="C"/>
                                <ComboBoxItem Content="C1"/>
                                <ComboBoxItem Content="CE"/>
                                <ComboBoxItem Content="C1E"/>
                                <ComboBoxItem Content="D"/>
                                <ComboBoxItem Content="D2"/>
                                <ComboBoxItem Content="D2E"/>
                                <ComboBoxItem Content="DE"/>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" EditingElementStyle="{StaticResource CenteredDataGridEditingText}" Header="Họ tên"
                                    Binding="{Binding HOTEN}"
                                    Width="185"/>

                <DataGridTemplateColumn Header="Giới tính" Width="105">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox SelectedValue="{Binding GIOITINHVAL, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Tag"
                                      VerticalContentAlignment="Center">
                                <ComboBoxItem Content="0 : Nam" Tag="0"/>
                                <ComboBoxItem Content="1 : Nữ" Tag="1"/>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" EditingElementStyle="{StaticResource CenteredDataGridEditingText}" Header="Ngày sinh"
                                    Binding="{Binding NGAYSINH}"
                                    Width="115"/>

                <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" EditingElementStyle="{StaticResource CenteredDataGridEditingText}" Header="CCCD/CMND/Hộ chiếu"
                                    Binding="{Binding SOCMND_PASSPORT}"
                                    Width="180"/>

                <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" EditingElementStyle="{StaticResource CenteredDataGridEditingText}" Header="Ngày cấp"
                                    Binding="{Binding NGAYTHANGNAMCAPCMND}"
                                    Width="115"/>

                <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" EditingElementStyle="{StaticResource CenteredDataGridEditingText}" Header="Nơi cấp"
                                    Binding="{Binding NOICAP}"
                                    Width="185"/>

                <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" EditingElementStyle="{StaticResource CenteredDataGridEditingText}" Header="Địa chỉ"
                                    Binding="{Binding DIACHITHUONGTRU}"
                                    Width="270"/>

                <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" EditingElementStyle="{StaticResource CenteredDataGridEditingText}" Header="Mã tỉnh"
                                    Binding="{Binding MATINH_THUONGTRU}"
                                    Width="95"/>

                <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" EditingElementStyle="{StaticResource CenteredDataGridEditingText}" Header="Mã xã"
                                    Binding="{Binding MAXA_THUONGTRU}"
                                    Width="100"/>

                <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" EditingElementStyle="{StaticResource CenteredDataGridEditingText}" Header="Mã CSKCB"
                                    Binding="{Binding IDBENHVIEN}"
                                    Width="105"/>

                <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" EditingElementStyle="{StaticResource CenteredDataGridEditingText}" Header="Cơ sở KCB"
                                    Binding="{Binding BENHVIEN}"
                                    Width="225"/>

                <DataGridTemplateColumn Header="Ma túy" Width="125">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox SelectedValue="{Binding MATUY, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="0 : Âm tính" Tag="0"/>
                                <ComboBoxItem Content="1 : Dương tính" Tag="1"/>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" EditingElementStyle="{StaticResource CenteredDataGridEditingText}" Header="Ngày kết luận"
                                    Binding="{Binding NGAYKETLUAN}"
                                    Width="120"/>

                <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" EditingElementStyle="{StaticResource CenteredDataGridEditingText}" Header="Bác sĩ kết luận"
                                    Binding="{Binding BACSYKETLUAN}"
                                    Width="185"/>

                <DataGridTemplateColumn Header="Kết luận" Width="330">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox SelectedValue="{Binding KETLUAN, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="A0-1 : Đủ điều kiện sức khỏe lái xe hạng ……" Tag="A0-1"/>
                                <ComboBoxItem Content="A0-2 : Không đủ điều kiện sức khỏe lái xe hạng ….." Tag="A0-2"/>
                                <ComboBoxItem Content="A0-3 : Đạt tiêu chuẩn nhưng yêu cầu khám lại …" Tag="A0-3"/>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="STATE" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox SelectedValue="{Binding STATE, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Content">
                                <ComboBoxItem Content="ADD"/>
                                <ComboBoxItem Content="EDIT"/>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" EditingElementStyle="{StaticResource CenteredDataGridEditingText}" Header="Kiểm tra"
                                    Binding="{Binding ValidationStatus}"
                                    IsReadOnly="True"
                                    Width="110"/>

                <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" EditingElementStyle="{StaticResource CenteredDataGridEditingText}" Header="Nội dung lỗi"
                                    Binding="{Binding ErrorMessage}"
                                    IsReadOnly="True"
                                    Width="300"/>

                <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" EditingElementStyle="{StaticResource CenteredDataGridEditingText}" Header="Trạng thái gửi"
                                    Binding="{Binding SendStatus}"
                                    IsReadOnly="True"
                                    Width="125"/>

                <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" EditingElementStyle="{StaticResource CenteredDataGridEditingText}" Header="Phản hồi API"
                                    Binding="{Binding ApiMessage}"
                                    IsReadOnly="True"
                                    Width="260"/>

                <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" EditingElementStyle="{StaticResource CenteredDataGridEditingText}" Header="UUID"
                                    Binding="{Binding UUID}"
                                    IsReadOnly="True"
                                    Width="250"/>

            </DataGrid.Columns>
        </DataGrid>
                </DockPanel>
            </TabItem>


            <TabItem Header="KSK">
                <DockPanel>

                    <!-- Toolbar KSK thường -->
                    <Border DockPanel.Dock="Top"
                            Background="White"
                            Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <WrapPanel Grid.Column="0"
                                       VerticalAlignment="Center">

                                <Button x:Name="LoadGeneralSqlButton"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,10,0"
                                        Padding="14,8"
                                        Click="LoadGeneralSql_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource ButtonIcon}"
                                                   Text="&#xE895;"/>
                                        <TextBlock Text="Lấy dữ liệu SQL"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,10,0"
                                        Padding="14,8"
                                        Click="SelectGeneralPackages_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource ButtonIcon}"
                                                   Text="&#xE71B;"/>
                                        <TextBlock Text="Chọn gói"/>
                                    </StackPanel>
                                </Button>

                                <CheckBox x:Name="GeneralOnlyPaidCheck"
                                          Content="Thanh toán"
                                          VerticalAlignment="Center"
                                          Margin="0,0,16,0"/>
                            </WrapPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Xuất excel"
                                    Padding="14,8"
                                    Click="ExportGeneralExcel_Click"/>
                        </Grid>
                    </Border>

                    <!-- Tìm kiếm KSK thường -->
                    <Border DockPanel.Dock="Top"
                            Background="White"
                            BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="0,0,0,1"
                            Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Kiểu lọc:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="GeneralFilterTypeCombo" Width="165" Height="30" Margin="0,0,12,0" SelectedIndex="0" SelectionChanged="GeneralFilterType_Changed">
                                    <ComboBoxItem Content="Từ ngày - Đến ngày" Tag="RANGE"/><ComboBoxItem Content="Ngày" Tag="DAY"/><ComboBoxItem Content="Tháng" Tag="MONTH"/><ComboBoxItem Content="Quý" Tag="QUARTER"/><ComboBoxItem Content="Năm" Tag="YEAR"/>
                                </ComboBox>
                                <StackPanel x:Name="GeneralRangePanel" Orientation="Horizontal"><TextBlock Text="Từ ngày:" VerticalAlignment="Center" Margin="0,0,6,0"/><DatePicker x:Name="GeneralFromDatePicker" Width="125" Height="30" Margin="0,0,10,0"/><TextBlock Text="Đến ngày:" VerticalAlignment="Center" Margin="0,0,6,0"/><DatePicker x:Name="GeneralToDatePicker" Width="125" Height="30" Margin="0,0,12,0"/></StackPanel>
                                <StackPanel x:Name="GeneralDayPanel" Orientation="Horizontal" Visibility="Collapsed"><TextBlock Text="Ngày:" VerticalAlignment="Center" Margin="0,0,6,0"/><DatePicker x:Name="GeneralDayPicker" Width="125" Height="30" Margin="0,0,12,0"/></StackPanel>
                                <StackPanel x:Name="GeneralMonthPanel" Orientation="Horizontal" Visibility="Collapsed"><TextBlock Text="Tháng:" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="GeneralMonthCombo" Width="80" Height="30" Margin="0,0,12,0"/><TextBlock Text="Năm:" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="GeneralMonthYearCombo" Width="90" Height="30" Margin="0,0,12,0"/></StackPanel>
                                <StackPanel x:Name="GeneralQuarterPanel" Orientation="Horizontal" Visibility="Collapsed"><TextBlock Text="Quý:" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="GeneralQuarterCombo" Width="80" Height="30" Margin="0,0,12,0"/><TextBlock Text="Năm:" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="GeneralQuarterYearCombo" Width="90" Height="30" Margin="0,0,12,0"/></StackPanel>
                                <StackPanel x:Name="GeneralYearPanel" Orientation="Horizontal" Visibility="Collapsed"><TextBlock Text="Năm:" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="GeneralYearCombo" Width="90" Height="30" Margin="0,0,12,0"/></StackPanel>
                            </WrapPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox x:Name="GeneralSearchBox"
                                         Width="320"
                                         Height="30"
                                         VerticalContentAlignment="Center"
                                         KeyDown="GeneralSearchBox_KeyDown"/>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Content="⌕  Tìm kiếm"
                                        Width="100"
                                        Height="30"
                                        Margin="6,0,0,0"
                                        Padding="8,3"
                                        Click="GeneralSearch_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Bottom"
                            Background="White"
                            BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="0,1,0,0"
                            Padding="10">
                        <TextBlock x:Name="GeneralStatusText"
                                   Text="Sẵn sàng."/>
                    </Border>

                    <!-- TableView riêng cho KSK thường -->
                    <DataGrid x:Name="GeneralGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="False"
                              SelectionUnit="FullRow"
                              SelectionMode="Extended"
                              FrozenColumnCount="2"
                              Margin="16,10,16,14"
                              HeadersVisibility="All"
                              GridLinesVisibility="All"
                              VerticalContentAlignment="Center">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridRow"
                                   BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="VerticalContentAlignment"
                                        Value="Center"/>
                            </Style>

                            <Style TargetType="DataGridCell"
                                   BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="VerticalContentAlignment"
                                        Value="Center"/>
                            </Style>

                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>
                            </Style>

                            <Style TargetType="ComboBox"
                                   BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>
                                <Setter Property="VerticalContentAlignment"
                                        Value="Center"/>
                            </Style>

                            <Style TargetType="CheckBox"
                                   BasedOn="{StaticResource {x:Type CheckBox}}">
                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>

                            <DataGridTemplateColumn Width="45">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox x:Name="GeneralSelectAllHeaderCheck"
                                              IsThreeState="True"
                                              Click="GeneralSelectAllHeaderCheck_Click"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" Header="Số KSK"
                                                Binding="{Binding SO}"
                                                Width="215"/>

                            <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" Header="Người giới thiệu"
                                                Binding="{Binding IntroName}"
                                                Width="170"
                                                IsReadOnly="True"/>

                            <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" Header="Tên Gói Khám"
                                                Binding="{Binding ServiceName}"
                                                Width="220"
                                                IsReadOnly="True"/>

                            <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" Header="Ngày tạo"
                                                Binding="{Binding CreateDate, StringFormat=dd/MM/yyyy HH:mm}"
                                                Width="150"
                                                IsReadOnly="True"/>

                            <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" Header="Loại KSK"
                                                Binding="{Binding GeneralHealthCategory}"
                                                Width="160"
                                                IsReadOnly="True"/>

                            <DataGridTemplateColumn Header="Loại Sức khỏe"
                                                    Width="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding GeneralHealthType, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Content"
                                                  VerticalAlignment="Center"
                                                  VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="LOẠI 1"/>
                                            <ComboBoxItem Content="LOẠI 2"/>
                                            <ComboBoxItem Content="LOẠI 3"/>
                                            <ComboBoxItem Content="LOẠI 4"/>
                                            <ComboBoxItem Content="LOẠI 5"/>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" Header="Họ tên"
                                                Binding="{Binding HOTEN}"
                                                Width="190"/>

                            <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" Header="Ngày sinh"
                                                Binding="{Binding NGAYSINH}"
                                                Width="120"/>

                            <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" Header="Giới tính"
                                                Binding="{Binding GenderDisplay}"
                                                Width="90"
                                                IsReadOnly="True"/>

                            <DataGridTemplateColumn Header="Thanh Toán" Width="125">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="PaidBadge"
                                    Background="#FFF4CC"
                                    BorderBrush="#F1C84B"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="PaidBadgeTextBlock"
                                           Text="{Binding PaidDisplay}"
                                           Style="{StaticResource PaidBadgeText}"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding PaidDisplay}"
                                             Value="Đã Thanh Toán">
                                    <Setter TargetName="PaidBadge"
                                            Property="Background"
                                            Value="#DDF7E8"/>
                                    <Setter TargetName="PaidBadge"
                                            Property="BorderBrush"
                                            Value="#68C98C"/>
                                    <Setter TargetName="PaidBadgeTextBlock"
                                            Property="Foreground"
                                            Value="#16713B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PaidDisplay}"
                                             Value="Đã thanh toán">
                                    <Setter TargetName="PaidBadge"
                                            Property="Background"
                                            Value="#DDF7E8"/>
                                    <Setter TargetName="PaidBadge"
                                            Property="BorderBrush"
                                            Value="#68C98C"/>
                                    <Setter TargetName="PaidBadgeTextBlock"
                                            Property="Foreground"
                                            Value="#16713B"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Dữ liệu Xml">
                <local:XmlDataView/>
            </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
