<Window x:Class="GKSKLaiXe.Windows.SqlSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cấu hình SQL" Height="390" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Server" VerticalAlignment="Center"/>
        <TextBox x:Name="ServerBox" Grid.Row="0" Grid.Column="1" Margin="0,5"/>

        <TextBlock Grid.Row="1" Text="Port" VerticalAlignment="Center"/>
        <TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="1" Margin="0,5"/>

        <TextBlock Grid.Row="2" Text="Database" VerticalAlignment="Center"/>
        <TextBox x:Name="DatabaseBox" Grid.Row="2" Grid.Column="1" Margin="0,5"/>

        <TextBlock Grid.Row="3" Text="Username" VerticalAlignment="Center"/>
        <TextBox x:Name="UsernameBox" Grid.Row="3" Grid.Column="1" Margin="0,5"/>

        <TextBlock Grid.Row="4" Text="Password" VerticalAlignment="Center"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="4" Grid.Column="1" Margin="0,5"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Kiểm tra kết nối" Width="140" Height="34" Margin="0,0,10,0"
                    Click="Test_Click"/>
            <Button Content="Lưu cấu hình" Width="120" Height="34" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
