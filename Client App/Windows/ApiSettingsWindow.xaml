<Window x:Class="GKSKLaiXe.Windows.ApiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cấu hình liên thông" Height="330" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="API URL" VerticalAlignment="Center"/>
        <TextBox x:Name="UrlBox" Grid.Row="0" Grid.Column="1" Margin="0,7"/>

        <TextBlock Grid.Row="1" Text="Username" VerticalAlignment="Center"/>
        <TextBox x:Name="UsernameBox" Grid.Row="1" Grid.Column="1" Margin="0,7"/>

        <TextBlock Grid.Row="2" Text="Password" VerticalAlignment="Center"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="2" Grid.Column="1" Margin="0,7"/>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
            <Button Style="{StaticResource PrimaryButton}" Content="Lưu cấu hình" Width="130" Height="34"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
