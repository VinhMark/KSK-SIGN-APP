<Window x:Class="GKSKLaiXe.Windows.PackageSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn gói khám"
        Height="560"
        Width="560"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filter tên gói -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Tìm tên gói:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

            <TextBox x:Name="PackageSearchBox"
                     Height="30"
                     VerticalContentAlignment="Center"
                     TextChanged="PackageSearchBox_TextChanged"/>
        </DockPanel>

        <!-- Chọn nhanh -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">

            <Button Style="{StaticResource SecondaryButton}" Content="Chọn tất cả đang hiển thị"
                    Width="175"
                    Margin="0,0,8,0"
                    Click="SelectAll_Click"/>

            <Button Style="{StaticResource SecondaryButton}" Content="Bỏ chọn tất cả đang hiển thị"
                    Width="190"
                    Click="ClearAll_Click"/>
        </StackPanel>

        <!-- Danh sách gói -->
        <Border Grid.Row="2"
                BorderBrush="#D9D9D9"
                BorderThickness="1">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PackageList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="10,7"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Action -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">

            <TextBlock x:Name="SelectedCountText"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"/>

            <Button Style="{StaticResource SecondaryButton}" Content="Hủy"
                    Width="90"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"/>

            <Button Style="{StaticResource PrimaryButton}" Content="Áp dụng"
                    Width="100"
                    Click="Apply_Click"/>
        </StackPanel>
    </Grid>
</Window>
